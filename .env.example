# ===== 大模型配置 =====
# DashScope API Key（必填，从阿里云灵积平台获取）
DASHSCOPE_API_KEY=your_dashscope_api_key

# API 基础地址（DashScope 兼容 OpenAI 格式）
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Agent 主模型（推荐 qwen-plus，平衡性能与成本）
AGENT_BASE_MODEL=qwen3.5-flash-2026-02-23

# 记忆提取模型（后台任务使用，建议用小模型节省成本）
SUMMARIZATION_MODEL=qwen-turbo

# ===== 嵌入模型配置 =====
# 文本向量化模型（用于知识库和记忆的语义检索）
EMBEDDING_MODEL=text-embedding-v4

# 向量维度（text-embedding-v4 为 1024 维）
dense_dimension=1024

# ===== Rerank 重排序配置 =====
# 重排序模型（用于优化检索结果的相关性排序）
RERANK_MODEL=gte-rerank-v2

# 重排序 API 地址
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# 重排序 API Key（默认与 DASHSCOPE_API_KEY 相同）
RERANK_API_KEY=your_dashscope_api_key

# ===== Milvus 向量数据库配置 =====
# Zilliz Cloud 服务地址（或自建 Milvus 地址）
Milvus_url=your_milvus_url

# 认证 Token（Zilliz Cloud 格式：username:password）
Token=your_milvus_token

# 知识库集合名称
knowledge_base_collection=knowledge_base_collection

# 记忆集合名称
memory_collection=memory_collection

# ===== PostgreSQL 数据库配置 =====
# 完整连接字符串（包含用户名、密码、主机、端口、数据库名）
DATABASE_URL=postgresql://user:pass@localhost:5432/echomind_db?sslmode=disable

# 分项配置（用于程序自动创建数据库）
user=your_db_user
password=your_db_password
host=localhost
port=5432
db_name=echomind_db

# ===== Redis 配置 =====
# Redis 连接地址（用于对话检查点存储和用户画像缓存）
REDIS_URL=redis://localhost:6379/0

# ===== 临时文件目录 =====
# 文档上传后的临时存储路径
TEMP_DIR=/tmp

# Knowledge-base retrieval diagnostics (counts/timing only, no document/query logs)
RAG_TRACE_ENABLED=false
# Graph indexing and online recall can be enabled independently
GRAPH_RAG_ENABLED=false
GRAPH_EXTRACTION_ENABLED=false
EVIDENCE_CHECK_ENABLED=false
GRAPH_EXTRACTION_VERSION=v3
# Defaults to AGENT_BASE_MODEL; uses BASE_URL and DASHSCOPE_API_KEY
# GRAPH_EXTRACTION_MODEL=your_available_model
GRAPH_EXTRACTION_BATCH_SIZE=4
GRAPH_EXTRACTION_TIMEOUT_SECONDS=30
# Per-generation hard budgets; servers may lower these, never exceed 200/400.
GRAPH_JOB_MAX_PARENTS=200
GRAPH_JOB_MAX_CALLS=400
GRAPH_MAX_HOPS=2
GRAPH_MAX_SEEDS=3
GRAPH_MAX_RELATIONS=20
GRAPH_MAX_EVIDENCE_PARENTS=5
GRAPH_QUERY_TIMEOUT_MS=400
GRAPH_BRIDGE_QUOTA=2

# Evidence check: conservative local rules, at most one scoped supplemental search.
EVIDENCE_MAX_RETRIEVAL_ROUNDS=1
EVIDENCE_EXTRA_PARENT_LIMIT=3
EVIDENCE_CHECK_TIMEOUT_MS=800
EVIDENCE_RETRIEVAL_TIMEOUT_MS=10000
EVIDENCE_TOTAL_TIMEOUT_MS=12000
EVIDENCE_MAX_CONTEXT_CHARS=12000

# Identity: keep loopback-only local use, or configure password for shared access.
ECHOMIND_AUTH_MODE=local
ECHOMIND_LOCAL_USER_ID=1
# ECHOMIND_ALLOWED_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
# Frontend API location (tokens are bound to this origin).
ECHOMIND_API_BASE_URL=http://127.0.0.1:8000

# Per-chat generation budgets (provider-reported token usage is not a bill).
CHAT_TOTAL_TIMEOUT_SECONDS=120
CHAT_MAX_MODEL_CALLS=4
CHAT_MAX_OUTPUT_TOKENS=4096
# Contextual conversations: conservative UTF-8 byte-based input estimate,
# including system/messages/tool schema + 1024 protocol reserve. Not a model window claim.
CHAT_CONTEXT_INPUT_TOKENS=65536
CHAT_MAX_ACTIVE_PER_USER=4
CHAT_MAX_ACTIVE_TOTAL=12
